# Single source of truth for packaged versions. Bump here, then tag apt/v<RCLRS>-<REV>.
# rclrs version is read from rclrs/Cargo.toml; the release tag must match it.
COLCON_ROS_CARGO_VERSION=0.2.0
CARGO_AMENT_BUILD_VERSION=0.1.11
# Distro -> Ubuntu codename -> container image
DISTROS="jazzy lyrical"
MAINTAINER="Signalbotics ROS 2 Rust packaging <signalbotics@users.noreply.github.com>"
CODENAME_jazzy=noble
CODENAME_lyrical=resolute
# Public apt repo (GitHub Pages of signalbotics/ros2_rust)
APT_URL="https://signalbotics.github.io/ros2_rust"
